# Copie para .env. Nunca envie segredos ao Git ou ao chat.
# Funciona sem configuração externa: SQLite local no servidor.
VITE_BACKEND=local
LOCAL_DATA_DIR=./data
# Defina apenas se usar proxy reverso com origem diferente da URL interna.
# APP_ORIGIN=https://seu-dominio.example

# Opcional: selecione VITE_BACKEND=supabase para usar seu projeto Supabase.
# Valores VITE_* são públicos e incorporados durante o build.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Só habilite depois de configurar Google em Auth > Providers.
VITE_GOOGLE_AUTH_ENABLED=false

# Servidor: mesmo backend do cliente.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Conexão Postgres do painel Supabase; usada apenas por npm run db:setup.
DATABASE_URL=
# Somente servidor, usada pelas cotas de IA. Não é necessária para cadastro/login.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: qualquer provedor compatível com Chat Completions.
# Preencha URL /v1, modelo disponível na sua conta e chave do provedor.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_DAILY_REQUEST_LIMIT=20
AI_MONTHLY_REQUEST_LIMIT=200

# Opcional: rotinas agendadas autenticadas.
CRON_SECRET=
CRON_SECRET_PREVIOUS=

# Monitoramento: token apenas no servidor para consultar /api/monitoring.
MONITORING_TOKEN=
# Opcional: persistência JSONL com rotação de 5 MB, fora da pasta pública.
# MONITORING_LOG_DIR=./data/monitoring

# Feedback: opção simples por SMTP, somente no servidor.
# Ative a verificação em duas etapas e crie uma senha em myaccount.google.com/apppasswords.
# Nunca use sua senha normal do Google ou prefixo VITE_ nestas variáveis.
GMAIL_APP_PASSWORD=
# Alternativa: API do Gmail com OAuth (opcional se usar senha de app).
# Autorize a conta remetente com o escopo https://www.googleapis.com/auth/gmail.send.
# Destino fixo: system.ifsc@gmail.com. Nunca use prefixo VITE_ nestas variáveis.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=system.ifsc@gmail.com
