# Copie para .env e preencha. Nunca commite valores reais de segredos.
# Variáveis VITE_* são incorporadas ao navegador; use apenas valores públicos.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Somente servidor. Mantenha estas variáveis fora do código do navegador.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Habilita tutor, geração de resumos/guias, flashcards, questões e avaliação discursiva.
# Configure via Secrets do Lovable em produção; requer créditos e acesso ao modelo no gateway.
LOVABLE_API_KEY=
# Limites explícitos por conta: cada pedido de chat/geração/correção consome uma unidade.
# A chave de serviço abaixo é necessária para reservar cotas atomicamente no servidor.
AI_DAILY_REQUEST_LIMIT=
AI_MONTHLY_REQUEST_LIMIT=

# Necessária no servidor para as cotas distribuídas de IA e rotinas administrativas.
# Nunca exponha esta chave com o prefixo VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Opcionais: autenticação de rotinas agendadas do Lovable.
# LOVABLE_CRON_SECRET=
# LOVABLE_CRON_SECRET_PREVIOUS=
